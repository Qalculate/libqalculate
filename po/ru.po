msgid "Unknown command."
msgstr "Неизвестная команда."

#: src/qalc.cc:7222
msgid "error"
msgstr "ошибка"

#: src/qalc.cc:7225
msgid "warning"
msgstr "предупреждение"

#: src/qalc.cc:7399
msgid ""
"Please select interpretation of expressions with implicit multiplication."
msgstr "Выберите интерпретацию выражений с неявным умножением."

#: src/qalc.cc:7403
msgid "Adaptive"
msgstr "Адаптивный"

#: src/qalc.cc:7408
msgid "Implicit multiplication first"
msgstr "Сначала анализировать неявное умножение"

#: src/qalc.cc:7413
msgid "Conventional"
msgstr "Общепринятый синтаксический анализ"

