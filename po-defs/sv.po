#: data/functions.xml.in:3867
msgid "Bitwise Complement (Not)"
msgstr "Bitvist komplement (Icke)"

#: data/functions.xml.in:3868
msgid ""
"Applies bitwise NOT to an integer of specified bit width and signedness (use "
"1 for signed and 0 for unsigned). If bit width is zero, the smallest "
"necessary number of bits (of 8, 16, 32, 64, 128, ...) will be used."
msgstr ""
"Applicerar bitvist NOT på ett heltal med angiven bitbredd och "
"teckenhantering - använd 1 för heltal med tecken (signed) och 0 för heltal "
"utan tecken (unsigned). Om bitbredden är noll används det minsta nödvändiga "
"antalet bitar (av 8, 16, 32, 64, 128, ...)."

